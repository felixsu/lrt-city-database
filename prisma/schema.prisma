// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum PaymentStatus {
  IN_PROGRESS
  PAID_OFF
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          AdminRole @default(ADMIN)
  promotedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Building {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model LoanBank {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id                 String        @id @default(cuid())
  name               String
  contactNumber      String
  remarks            String?
  loanBankId         String?
  loanBank           LoanBank?     @relation(fields: [loanBankId], references: [id])
  paymentStatus      PaymentStatus @default(IN_PROGRESS)
  paidOffDate        DateTime?
  buildingId         String?
  building           Building?     @relation(fields: [buildingId], references: [id])
  ownershipDocuments OwnershipDocument[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model OwnershipDocument {
  id                String   @id @default(cuid())
  accountNumber     String?  @unique
  unitNumber        String?  @unique
  unitType          String?
  ppjbDate          DateTime?
  sppuNumber        String?
  sppuDate          DateTime?
  sppuImageUrl      String?
  sppuImagePublicId String?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos            OwnershipDocumentPhoto[]
  createdAt         DateTime @default(now())
}

model OwnershipDocumentPhoto {
  id                  String            @id @default(cuid())
  ownershipDocumentId String
  ownershipDocument   OwnershipDocument @relation(fields: [ownershipDocumentId], references: [id], onDelete: Cascade)
  url                 String
  publicId            String
  bytes               Int?
  width               Int?
  height              Int?
  createdAt           DateTime          @default(now())
}

enum TimelineMediaType {
  PHOTO
  VIDEO
}

model TimelineEvent {
  id          String   @id @default(cuid())
  title       String
  description String
  eventDate   DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  media       TimelineEventMedia[]
}

model TimelineEventMedia {
  id              String            @id @default(cuid())
  timelineEventId String
  timelineEvent   TimelineEvent     @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  type            TimelineMediaType
  url             String
  publicId        String
  bytes           Int?
  width           Int?
  height          Int?
  createdAt       DateTime          @default(now())
}

model HomeContent {
  id                Int      @id @default(1)
  aboutTitle        String   @default("A transit-anchored home in Tebet")
  aboutMarkdown     String   @default("")
  howToJoinTitle    String   @default("Bergabung dengan kami")
  howToJoinMarkdown String   @default("")
  updatedAt         DateTime @updatedAt
}

model UploadSettings {
  id                  Int      @id @default(1)
  timelineMaxUploadMb Int      @default(10)
  ppjbMaxUploadMb     Int      @default(10)
  updatedAt           DateTime @updatedAt
}

model MediaLink {
  id          String   @id @default(cuid())
  url         String
  title       String?
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resource {
  id            String   @id @default(cuid())
  title         String
  description   String
  imageUrl      String?
  imagePublicId String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
